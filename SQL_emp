-- 1. Basic Selection & Filtering

-- 1.1 Retrieve all columns and all rows from the EMP table.
SELECT * FROM EMP;

-- 1.2 Select only the ENAME, JOB, and SAL of all employees.
SELECT ENAME, JOB, SAL FROM EMP;

-- 1.3 Find all employees working in department number 20.
SELECT * FROM EMP WHERE DEPTNO = 20;

-- 1.4 List all employees who earn a monthly salary greater than 2000.
SELECT * FROM EMP WHERE SAL > 2000;

-- 1.5 Display all employees whose job title is 'CLERK'.
SELECT * FROM EMP WHERE JOB = 'CLERK';

-- 1.6 Find all employees hired before January 1, 1982.
SELECT * FROM EMP WHERE HIREDATE < '1982-01-01';

-- 1.7 Retrieve all employees who are not managers (JOB != 'MANAGER').
SELECT * FROM EMP WHERE JOB != 'MANAGER';

-- 1.8 List all employees in department 30 with a salary greater than 1200.
SELECT * FROM EMP WHERE DEPTNO = 30 AND SAL > 1200;

-- 1.9 Display all employees who earn between 1000 and 3000 (inclusive).
SELECT * FROM EMP WHERE SAL BETWEEN 1000 AND 3000;

-- 1.10 Find all employees who work in either department 10 or department 20.
SELECT * FROM EMP WHERE DEPTNO IN (10, 20);


-- 2. Sorting, String Functions & Pattern Matching

-- 2.1 List all employees sorted by SAL in ascending order.
SELECT * FROM EMP ORDER BY SAL ASC;

-- 2.2 List all employees sorted by JOB alphabetically, and then by SAL in descending order.
SELECT * FROM EMP ORDER BY JOB ASC, SAL DESC;

-- 2.3 Display all employees whose name starts with the letter 'S'.
SELECT * FROM EMP WHERE ENAME LIKE 'S%';

-- 2.4 Find all employees whose name ends with 'N'.
SELECT * FROM EMP WHERE ENAME LIKE '%N';

-- 2.5 Select employees whose name contains "AR" anywhere in ENAME.
SELECT * FROM EMP WHERE ENAME LIKE '%AR%';

-- 2.6 Find employees whose name has exactly 4 characters.
SELECT * FROM EMP WHERE LENGTH(ENAME) = 4; -- Or: WHERE ENAME LIKE '____'

-- 2.7 Display ENAME in lowercase and JOB in initial capital case (INITCAP).
SELECT LOWER(ENAME) AS ename_lower, INITCAP(JOB) AS job_initcap FROM EMP;

-- 2.8 List ENAME along with the number of characters in each name (LENGTH).
SELECT ENAME, LENGTH(ENAME) AS Name_Length FROM EMP;

-- 2.9 Display the first 3 characters of each employee's name.
SELECT ENAME, SUBSTR(ENAME, 1, 3) AS First_3_Chars FROM EMP;

-- 2.10 Retrieve all employees whose name has 'A' as the second character.
SELECT * FROM EMP WHERE ENAME LIKE '_A%';


-- 3. NULL Values, Commissions & Arithmetic Expressions

-- 3.1 Find all employees who do not receive any commission (COMM IS NULL).
SELECT * FROM EMP WHERE COMM IS NULL;

-- 3.2 Find all employees who earn a positive commission (COMM IS NOT NULL and COMM > 0).
SELECT * FROM EMP WHERE COMM IS NOT NULL AND COMM > 0;

-- 3.3 Calculate the total annual base salary (SAL * 12) for each employee.
SELECT ENAME, SAL, (SAL * 12) AS Annual_Salary FROM EMP;

-- 3.4 Display employee name, salary, commission, and total monthly compensation (SAL + NVL(COMM, 0)).
SELECT ENAME, SAL, COMM, (SAL + COALESCE(COMM, 0)) AS Total_Monthly_Comp FROM EMP;

-- 3.5 Find employees whose commission is greater than their monthly salary.
SELECT * FROM EMP WHERE COMM > SAL;

-- 3.6 Retrieve employees whose MGR field is NULL (top-level executives).
SELECT * FROM EMP WHERE MGR IS NULL;

-- 3.7 Display ENAME, COMM, replacing NULL commission values with 0.
SELECT ENAME, COALESCE(COMM, 0) AS COMM_Val FROM EMP;

-- 3.8 Find all employees who explicitly receive a commission of 0.
SELECT * FROM EMP WHERE COMM = 0;

-- 3.9 Calculate daily salary assuming a 30-day month for each employee, rounded to 2 decimal places.
SELECT ENAME, SAL, ROUND(SAL / 30.0, 2) AS Daily_Salary FROM EMP;

-- 3.10 List employees whose salary after a 15% raise would exceed 3000.
SELECT ENAME, SAL, (SAL * 1.15) AS Raised_Sal FROM EMP WHERE (SAL * 1.15) > 3000;


-- 4. Aggregate Functions & GROUP BY

-- 4.1 Count the total number of employees in the company.
SELECT COUNT(*) AS Total_Employees FROM EMP;

-- 4.2 Find the minimum, maximum, and average salary across all employees.
SELECT MIN(SAL) AS Min_Sal, MAX(SAL) AS Max_Sal, AVG(SAL) AS Avg_Sal FROM EMP;

-- 4.3 Calculate the total monthly salary budget paid to all employees combined.
SELECT SUM(SAL) AS Total_Monthly_Payroll FROM EMP;

-- 4.4 Find the total number of distinct job roles in the company.
SELECT COUNT(DISTINCT JOB) AS Distinct_Job_Roles FROM EMP;

-- 4.5 Calculate the average salary for each department (DEPTNO).
SELECT DEPTNO, AVG(SAL) AS Avg_Salary FROM EMP GROUP BY DEPTNO;

-- 4.6 Find the maximum salary earned within each job designation (JOB).
SELECT JOB, MAX(SAL) AS Max_Salary FROM EMP GROUP BY JOB;

-- 4.7 Count how many employees work in each department.
SELECT DEPTNO, COUNT(*) AS Employee_Count FROM EMP GROUP BY DEPTNO;

-- 4.8 Find the total commission paid per department.
SELECT DEPTNO, SUM(COMM) AS Total_Comm FROM EMP WHERE COMM IS NOT NULL GROUP BY DEPTNO;

-- 4.9 Find the sum of salaries for each job role across the company.
SELECT JOB, SUM(SAL) AS Total_Job_Salary FROM EMP GROUP BY JOB;

-- 4.10 Calculate the total number of direct reports managed by each manager ID (MGR).
SELECT MGR, COUNT(*) AS Direct_Reports FROM EMP WHERE MGR IS NOT NULL GROUP BY MGR;



-- 5. Group Filtering with HAVING

-- 5.1 Find departments that have more than 3 employees.
SELECT DEPTNO, COUNT(*) AS Emp_Count FROM EMP GROUP BY DEPTNO HAVING COUNT(*) > 3;

-- 5.2 Display job designations where the average salary is greater than 2000.
SELECT JOB, AVG(SAL) AS Avg_Sal FROM EMP GROUP BY JOB HAVING AVG(SAL) > 2000;

-- 5.3 Find departments where the total salary payout exceeds 9000.
SELECT DEPTNO, SUM(SAL) AS Total_Payout FROM EMP GROUP BY DEPTNO HAVING SUM(SAL) > 9000;

-- 5.4 List job roles that are held by at least 2 employees.
SELECT JOB, COUNT(*) AS Role_Count FROM EMP GROUP BY JOB HAVING COUNT(*) >= 2;

-- 5.5 Find managers (MGR) who supervise more than 2 employees.
SELECT MGR, COUNT(*) AS Supervised_Count FROM EMP WHERE MGR IS NOT NULL GROUP BY MGR HAVING COUNT(*) > 2;

-- 5.6 Display departments where the maximum salary is less than 3000.
SELECT DEPTNO, MAX(SAL) AS Max_Sal FROM EMP GROUP BY DEPTNO HAVING MAX(SAL) < 3000;

-- 5.7 Find job titles where the minimum salary is at least 1000.
SELECT JOB, MIN(SAL) AS Min_Sal FROM EMP GROUP BY JOB HAVING MIN(SAL) >= 1000;

-- 5.8 List departments where the average commission is greater than 200.
SELECT DEPTNO, AVG(COMM) AS Avg_Comm FROM EMP WHERE COMM IS NOT NULL GROUP BY DEPTNO HAVING AVG(COMM) > 200;

-- 5.9 Find job roles in department 30 that have an average salary higher than 1200.
SELECT JOB, AVG(SAL) AS Avg_Sal FROM EMP WHERE DEPTNO = 30 GROUP BY JOB HAVING AVG(SAL) > 1200;

-- 5.10 Display departments where the sum of salaries is between 5000 and 10000.
SELECT DEPTNO, SUM(SAL) AS Total_Sal FROM EMP GROUP BY DEPTNO HAVING SUM(SAL) BETWEEN 5000 AND 10000;


-- 6. Joins & Self-Joins (Single-Table Context — WHERE Clause Joins)

-- 6.1 Write a self-join to display each employee's name alongside their direct manager's name.
SELECT e.ENAME AS Employee_Name, m.ENAME AS Manager_Name
FROM EMP e, EMP m
WHERE e.MGR = m.EMPNO;

-- 6.2 Find all employees who earn a higher salary than their direct manager.
SELECT e.ENAME AS Employee_Name, e.SAL AS Emp_Sal,
       m.ENAME AS Manager_Name, m.SAL AS Mgr_Sal
FROM EMP e, EMP m
WHERE e.MGR = m.EMPNO
  AND e.SAL > m.SAL;

-- 6.3 Display employees who were hired earlier than their direct manager.
SELECT e.ENAME AS Employee_Name, e.HIREDATE AS Emp_Hiredate,
       m.ENAME AS Manager_Name, m.HIREDATE AS Mgr_Hiredate
FROM EMP e, EMP m
WHERE e.MGR = m.EMPNO
  AND e.HIREDATE < m.HIREDATE;

-- 6.4 List all employees who share the exact same job title as 'SCOTT'.
SELECT e.ENAME, e.JOB
FROM EMP e, EMP s
WHERE s.ENAME = 'SCOTT'
  AND e.JOB = s.JOB
  AND e.ENAME != 'SCOTT';

-- 6.5 Find pairs of employees who work in the same department and hold the same job role.
SELECT e1.ENAME AS Employee_1, e2.ENAME AS Employee_2,
       e1.DEPTNO, e1.JOB
FROM EMP e1, EMP e2
WHERE e1.DEPTNO = e2.DEPTNO
  AND e1.JOB = e2.JOB
  AND e1.EMPNO < e2.EMPNO;

-- 6.6 Find all employees who work in the same department as 'BLAKE'.
SELECT e.ENAME, e.DEPTNO
FROM EMP e, EMP b
WHERE b.ENAME = 'BLAKE'
  AND e.DEPTNO = b.DEPTNO
  AND e.ENAME != 'BLAKE';

-- 6.7 Write a self-join to list all managers and their count of direct reports.
SELECT m.ENAME AS Manager_Name, COUNT(e.EMPNO) AS Direct_Reports_Count
FROM EMP m, EMP e
WHERE e.MGR = m.EMPNO
GROUP BY m.EMPNO, m.ENAME;

-- 6.8 List employees who earn the exact same salary as at least one other employee.
SELECT DISTINCT e1.ENAME, e1.SAL
FROM EMP e1, EMP e2
WHERE e1.SAL = e2.SAL
  AND e1.EMPNO != e2.EMPNO;

-- 6.9 Find employees who report to the same manager as 'SMITH'.
SELECT e.ENAME, e.MGR
FROM EMP e, EMP s
WHERE s.ENAME = 'SMITH'
  AND e.MGR = s.MGR
  AND e.ENAME != 'SMITH';

-- 6.10 Show employee name, job, manager name, and manager's job side-by-side.
SELECT e.ENAME AS Emp_Name, e.JOB AS Emp_Job,
       m.ENAME AS Mgr_Name, m.JOB AS Mgr_Job
FROM EMP e, EMP m
WHERE e.MGR = m.EMPNO;


-- 7. Subqueries (Single-Row, Multi-Row, Correlated)

-- 7.1 Find employees who earn more than the overall average salary of the company.
SELECT ENAME, SAL FROM EMP WHERE SAL > (SELECT AVG(SAL) FROM EMP);

-- 7.2 Find the employee(s) who earn the highest salary in the entire company.
SELECT ENAME, SAL FROM EMP WHERE SAL = (SELECT MAX(SAL) FROM EMP);

-- 7.3 Find employees who work in the department with the highest average salary.
SELECT ENAME, DEPTNO, SAL
FROM EMP
WHERE DEPTNO = (
  SELECT DEPTNO
  FROM EMP
  GROUP BY DEPTNO
  ORDER BY AVG(SAL) DESC
  LIMIT 1
);

-- 7.4 Find all employees who earn more than every employee in department 30 (ALL operator).
SELECT ENAME, SAL FROM EMP WHERE SAL > ALL (SELECT SAL FROM EMP WHERE DEPTNO = 30);

-- 7.5 Find employees who earn more than at least one employee in department 30 (ANY operator).
SELECT ENAME, SAL FROM EMP WHERE SAL > ANY (SELECT SAL FROM EMP WHERE DEPTNO = 30);

-- 7.6 Find employees whose salary is equal to the minimum salary of their respective department.
SELECT ENAME, DEPTNO, SAL
FROM EMP e
WHERE SAL = (SELECT MIN(SAL) FROM EMP WHERE DEPTNO = e.DEPTNO);

-- 7.7 Find all employees whose job title matches 'JONES''s job or whose salary is >= 'FORD''s salary.
SELECT ENAME, JOB, SAL
FROM EMP
WHERE JOB = (SELECT JOB FROM EMP WHERE ENAME = 'JONES')
   OR SAL >= (SELECT SAL FROM EMP WHERE ENAME = 'FORD');

-- 7.8 List employees who do not manage anyone (employees whose EMPNO is not in MGR).
SELECT ENAME, EMPNO FROM EMP WHERE EMPNO NOT IN (SELECT MGR FROM EMP WHERE MGR IS NOT NULL);

-- 7.9 Find employees who earn higher than the average salary of their own department (correlated subquery).
SELECT ENAME, DEPTNO, SAL
FROM EMP e
WHERE SAL > (SELECT AVG(SAL) FROM EMP WHERE DEPTNO = e.DEPTNO);

-- 7.10 Display the second highest salary in the company using a nested subquery.
SELECT MAX(SAL) AS Second_Highest_Salary FROM EMP WHERE SAL < (SELECT MAX(SAL) FROM EMP);


-- 8. Date & Time Functions

-- 8.1 List all employees hired in the year 1981.
SELECT ENAME, HIREDATE FROM EMP WHERE EXTRACT(YEAR FROM HIREDATE) = 1981;

-- 8.2 Find employees hired in the month of December (any year).
SELECT ENAME, HIREDATE FROM EMP WHERE EXTRACT(MONTH FROM HIREDATE) = 12;

-- 8.3 Calculate the total tenure in years for each employee based on HIREDATE.
SELECT ENAME, HIREDATE, FLOOR(DATEDIFF(CURRENT_DATE, HIREDATE) / 365.25) AS Tenure_Years FROM EMP;

-- 8.4 Display employees hired on the first day of any month.
SELECT ENAME, HIREDATE FROM EMP WHERE EXTRACT(DAY FROM HIREDATE) = 1;

-- 8.5 Order all employees by their tenure/experience (longest-serving first).
SELECT ENAME, HIREDATE FROM EMP ORDER BY HIREDATE ASC;

-- 8.6 Find the employee who has been with the company the longest (earliest HIREDATE).
SELECT ENAME, HIREDATE FROM EMP WHERE HIREDATE = (SELECT MIN(HIREDATE) FROM EMP);

-- 8.7 List employees hired between February 1, 1981, and September 30, 1981.
SELECT ENAME, HIREDATE FROM EMP WHERE HIREDATE BETWEEN '1981-02-01' AND '1981-09-30';

-- 8.8 Display ENAME, HIREDATE, and the day of the week (e.g., Monday) they were hired on.
SELECT ENAME, HIREDATE, TO_CHAR(HIREDATE, 'Day') AS Day_Of_Week FROM EMP;

-- 8.9 Find all employees hired in leap years.
SELECT ENAME, HIREDATE FROM EMP
WHERE (EXTRACT(YEAR FROM HIREDATE) % 4 = 0 AND EXTRACT(YEAR FROM HIREDATE) % 100 != 0)
   OR (EXTRACT(YEAR FROM HIREDATE) % 400 = 0);


-- 10. Window Functions & Advanced Analytics

-- 10.1 Rank employees globally by salary using DENSE_RANK().
SELECT ENAME, SAL, DENSE_RANK() OVER (ORDER BY SAL DESC) AS Salary_Rank FROM EMP;

-- 10.2 Assign a unique sequential row number to employees within each department using ROW_NUMBER().
SELECT ENAME, DEPTNO, SAL, ROW_NUMBER() OVER (PARTITION BY DEPTNO ORDER BY SAL DESC) AS Row_Seq FROM EMP;

-- 10.3 Retrieve the top 3 highest earners in the company using window functions.
SELECT ENAME, SAL, Salary_Rank
FROM (
  SELECT ENAME, SAL, DENSE_RANK() OVER (ORDER BY SAL DESC) AS Salary_Rank
  FROM EMP
) ranked
WHERE Salary_Rank <= 3;

-- 10.4 Find the top earner within each department using RANK().
SELECT DEPTNO, ENAME, SAL
FROM (
  SELECT DEPTNO, ENAME, SAL, RANK() OVER (PARTITION BY DEPTNO ORDER BY SAL DESC) AS Dept_Rank
  FROM EMP
) ranked
WHERE Dept_Rank = 1;

-- 10.5 Calculate a cumulative running total of salaries ordered by HIREDATE.
SELECT ENAME, HIREDATE, SAL,
       SUM(SAL) OVER (ORDER BY HIREDATE ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS Running_Total_Salary
FROM EMP;

-- 10.6 Calculate the difference between each employee's salary and their department's average salary.
SELECT ENAME, DEPTNO, SAL, SAL - AVG(SAL) OVER (PARTITION BY DEPTNO) AS Diff_From_Dept_Avg FROM EMP;

-- 10.7 Display each employee's salary alongside the next higher salary in their department using LEAD().
SELECT ENAME, DEPTNO, SAL, LEAD(SAL) OVER (PARTITION BY DEPTNO ORDER BY SAL ASC) AS Next_Higher_Sal FROM EMP;

-- 10.8 Compare each employee's salary with the salary of the employee hired immediately before them using LAG().
SELECT ENAME, HIREDATE, SAL,
       LAG(SAL) OVER (ORDER BY HIREDATE ASC) AS Prev_Hired_Sal,
       SAL - LAG(SAL) OVER (ORDER BY HIREDATE ASC) AS Sal_Difference
FROM EMP;

-- 10.9 Divide all employees into 4 equal salary quartiles using NTILE(4).
SELECT ENAME, SAL, NTILE(4) OVER (ORDER BY SAL ASC) AS Salary_Quartile FROM EMP;

-- 10.10 Calculate the exact percentage contribution of each employee's salary to their department's total salary.
SELECT ENAME, DEPTNO, SAL,
       ROUND((SAL * 100.0) / SUM(SAL) OVER (PARTITION BY DEPTNO), 2) AS Pct_Dept_Salary
FROM EMP;


-- PART 2: 50 Multi-Table Questions (EMP & DEPT Relational Joins & Subqueries)

-- 1. Inner Joins & Multi-Table Filtering (WHERE-Clause Syntax)

-- 2.1.1 Display each employee's name (ENAME), job title (JOB), salary (SAL), department name (DNAME), and location (LOC).
SELECT e.ENAME, e.JOB, e.SAL, d.DNAME, d.LOC
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO;

-- 2.1.2 List all employees who work in the 'RESEARCH' department.
SELECT e.ENAME, e.JOB, d.DNAME
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
  AND d.DNAME = 'RESEARCH';

-- 2.1.3 Retrieve all employees located in 'NEW YORK' or 'CHICAGO'.
SELECT e.ENAME, d.DNAME, d.LOC
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
  AND d.LOC IN ('NEW YORK', 'CHICAGO');

-- 2.1.4 Find all 'SALESMAN' employees along with their department name and location.
SELECT e.ENAME, e.JOB, d.DNAME, d.LOC
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
  AND e.JOB = 'SALESMAN';

-- 2.1.5 Display the employee name, salary, and department name for employees earning more than 2000.
SELECT e.ENAME, e.SAL, d.DNAME
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
  AND e.SAL > 2000;

-- 2.1.6 Find all employees hired in 1981 along with their department location.
SELECT e.ENAME, e.HIREDATE, d.LOC
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
  AND EXTRACT(YEAR FROM e.HIREDATE) = 1981;

-- 2.1.7 Display employee name, job, and department name for employees working in department 30 located in 'CHICAGO'.
SELECT e.ENAME, e.JOB, d.DNAME
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
  AND d.DEPTNO = 30
  AND d.LOC = 'CHICAGO';

-- 2.1.8 List all clerks (JOB = 'CLERK') alongside their department name and manager ID (MGR).
SELECT e.ENAME, e.JOB, d.DNAME, e.MGR
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
  AND e.JOB = 'CLERK';


-- 2. Outer Joins & Unmatched Records

-- 2.2.1 Display all departments (DNAME, LOC) along with the names of employees in them. Include departments that have no employees (e.g., 'OPERATIONS').
SELECT d.DNAME, d.LOC, e.ENAME
FROM DEPT d, EMP e
WHERE d.DEPTNO = e.DEPTNO(+);

-- 2.2.2 Find department details (DEPTNO, DNAME, LOC) that currently have zero assigned employees using a LEFT JOIN / subquery.
SELECT d.DEPTNO, d.DNAME, d.LOC
FROM DEPT d
WHERE NOT EXISTS (
  SELECT 1 FROM EMP e WHERE e.DEPTNO = d.DEPTNO
);



-- 2.2.5 Write a RIGHT JOIN query that displays all department names and their matching employee names.
SELECT d.DNAME, e.ENAME
FROM EMP e
RIGHT JOIN DEPT d ON e.DEPTNO = d.DEPTNO;


-- 3. Self-Joins with Department Information (WHERE-Clause Syntax)

-- 2.3.1 Display each employee's name along with their direct manager's name, department name, and department location.
SELECT e.ENAME AS Employee_Name,
       m.ENAME AS Manager_Name,
       d.DNAME AS Dept_Name,
       d.LOC AS Dept_Location
FROM EMP e, EMP m, DEPT d
WHERE e.MGR = m.EMPNO
  AND e.DEPTNO = d.DEPTNO;

-- 2.3.2 Find all employees who work in the same department location as their manager.
SELECT e.ENAME AS Employee, m.ENAME AS Manager, de.LOC AS Location
FROM EMP e, EMP m, DEPT de, DEPT dm
WHERE e.MGR = m.EMPNO
  AND e.DEPTNO = de.DEPTNO
  AND m.DEPTNO = dm.DEPTNO
  AND de.LOC = dm.LOC;

-- 2.3.3 List employees who earn a higher salary than their direct manager, showing both employee name, manager name, and department name.
SELECT e.ENAME AS Employee_Name, e.SAL AS Emp_Sal,
       m.ENAME AS Manager_Name, m.SAL AS Mgr_Sal,
       d.DNAME AS Dept_Name
FROM EMP e, EMP m, DEPT d
WHERE e.MGR = m.EMPNO
  AND e.DEPTNO = d.DEPTNO
  AND e.SAL > m.SAL;

-- 2.3.4 Find pairs of employees who work in the same department (DEPTNO) and hold the same job title (JOB).
SELECT e1.ENAME AS Employee_1, e2.ENAME AS Employee_2,
       d.DNAME, e1.JOB
FROM EMP e1, EMP e2, DEPT d
WHERE e1.DEPTNO = d.DEPTNO
  AND e1.DEPTNO = e2.DEPTNO
  AND e1.JOB = e2.JOB
  AND e1.EMPNO < e2.EMPNO;

-- 2.3.5 Display employees who were hired before their direct manager, along with their respective department names.
SELECT e.ENAME AS Employee, e.HIREDATE AS Emp_Hired,
       m.ENAME AS Manager, m.HIREDATE AS Mgr_Hired,
       d.DNAME AS Dept_Name
FROM EMP e, EMP m, DEPT d
WHERE e.MGR = m.EMPNO
  AND e.DEPTNO = d.DEPTNO
  AND e.HIREDATE < m.HIREDATE;

-- 2.3.6 List all managers, their department name, and the count of employees reporting to them.
SELECT m.ENAME AS Manager_Name, d.DNAME AS Dept_Name,
       COUNT(e.EMPNO) AS Report_Count
FROM EMP m, EMP e, DEPT d
WHERE e.MGR = m.EMPNO
  AND m.DEPTNO = d.DEPTNO
GROUP BY m.EMPNO, m.ENAME, d.DNAME;


-- 4. Single-Row Subqueries

-- 2.4.1 Find all employees who work in the same department as 'BLAKE'.
SELECT ENAME, DEPTNO
FROM EMP
WHERE DEPTNO = (SELECT DEPTNO FROM EMP WHERE ENAME = 'BLAKE')
  AND ENAME != 'BLAKE';

-- 2.4.2 Display the names and salaries of employees who earn more than the overall average salary of all employees.
SELECT ENAME, SAL FROM EMP WHERE SAL > (SELECT AVG(SAL) FROM EMP);

-- 2.4.3 Find all employees who work in the same location as 'SMITH'.
SELECT e.ENAME, d.LOC
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
  AND d.LOC = (
    SELECT d2.LOC
    FROM EMP e2, DEPT d2
    WHERE e2.DEPTNO = d2.DEPTNO AND e2.ENAME = 'SMITH'
  )
  AND e.ENAME != 'SMITH';

-- 2.4.4 List employees whose salary is greater than the average salary of the 'SALES' department.
SELECT e.ENAME, e.SAL
FROM EMP e
WHERE e.SAL > (
  SELECT AVG(e2.SAL)
  FROM EMP e2, DEPT d2
  WHERE e2.DEPTNO = d2.DEPTNO
    AND d2.DNAME = 'SALES'
);

-- 2.4.5 Find the employee(s) who earn the highest salary in the 'RESEARCH' department.
SELECT e.ENAME, e.SAL, d.DNAME
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
  AND d.DNAME = 'RESEARCH'
  AND e.SAL = (
    SELECT MAX(e2.SAL)
    FROM EMP e2, DEPT d2
    WHERE e2.DEPTNO = d2.DEPTNO AND d2.DNAME = 'RESEARCH'
  );

-- 2.4.6 Retrieve all employees hired after 'ALLEN'.
SELECT ENAME, HIREDATE FROM EMP WHERE HIREDATE > (SELECT HIREDATE FROM EMP WHERE ENAME = 'ALLEN');

-- 2.4.7 Find the department name and location of the employee who earns the lowest salary in the company.
SELECT d.DNAME, d.LOC, e.ENAME, e.SAL
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
  AND e.SAL = (SELECT MIN(SAL) FROM EMP);

-- 2.4.8 Display the employee name and job of all employees working in the same department as the employee with EMPNO = 7788.
SELECT ENAME, JOB, DEPTNO
FROM EMP
WHERE DEPTNO = (SELECT DEPTNO FROM EMP WHERE EMPNO = 7788)
  AND EMPNO != 7788;


-- 5. Multi-Row Subqueries (IN, ALL, ANY)

-- 2.5.1 Find all employees whose job title matches any job title present in department 10.
SELECT ENAME, JOB, DEPTNO FROM EMP WHERE JOB IN (SELECT JOB FROM EMP WHERE DEPTNO = 10);

-- 2.5.2 Retrieve all employees who earn more than all employees working in department 30 (> ALL).
SELECT ENAME, SAL, DEPTNO FROM EMP WHERE SAL > ALL (SELECT SAL FROM EMP WHERE DEPTNO = 30);

-- 2.5.3 Find all employees who earn more than at least one employee in department 30 (> ANY).
SELECT ENAME, SAL, DEPTNO FROM EMP WHERE SAL > ANY (SELECT SAL FROM EMP WHERE DEPTNO = 30);

-- 2.5.4 Display employee names and salaries for employees whose salary matches any employee's salary in the 'ACCOUNTING' department.
SELECT e.ENAME, e.SAL
FROM EMP e
WHERE e.SAL IN (
  SELECT e2.SAL
  FROM EMP e2, DEPT d2
  WHERE e2.DEPTNO = d2.DEPTNO
    AND d2.DNAME = 'ACCOUNTING'
);

-- 2.5.5 List departments (DNAME, LOC) that have employees earning more than 2500 using DEPTNO IN (...).
SELECT DNAME, LOC FROM DEPT WHERE DEPTNO IN (SELECT DEPTNO FROM EMP WHERE SAL > 2500);

-- 2.5.6 Find all employees who report to a manager located in 'CHICAGO'.
SELECT e.ENAME AS Employee, m.ENAME AS Manager, d.LOC AS Manager_Loc
FROM EMP e, EMP m, DEPT d
WHERE e.MGR = m.EMPNO
  AND m.DEPTNO = d.DEPTNO
  AND d.LOC = 'CHICAGO';

-- 2.5.7 Find employees whose job title is NOT present in department 20.
SELECT ENAME, JOB, DEPTNO FROM EMP WHERE JOB NOT IN (SELECT DISTINCT JOB FROM EMP WHERE DEPTNO = 20);


-- 6. Correlated Subqueries & EXISTS / NOT EXISTS

-- 2.6.1 Find all employees who earn more than the average salary of their own department.
SELECT e.ENAME, e.DEPTNO, e.SAL
FROM EMP e
WHERE e.SAL > (SELECT AVG(e2.SAL) FROM EMP e2 WHERE e2.DEPTNO = e.DEPTNO);

-- 2.6.2 Display departments (DNAME, LOC) that have at least one employee using EXISTS.
SELECT d.DNAME, d.LOC FROM DEPT d WHERE EXISTS (SELECT 1 FROM EMP e WHERE e.DEPTNO = d.DEPTNO);

-- 2.6.3 Display departments (DNAME, LOC) that have no employees using NOT EXISTS.
SELECT d.DNAME, d.LOC FROM DEPT d WHERE NOT EXISTS (SELECT 1 FROM EMP e WHERE e.DEPTNO = d.DEPTNO);

-- 2.6.4 Find employees who earn the maximum salary in their respective department.
SELECT e.ENAME, e.DEPTNO, e.SAL
FROM EMP e
WHERE e.SAL = (SELECT MAX(e2.SAL) FROM EMP e2 WHERE e2.DEPTNO = e.DEPTNO);

-- 2.6.5 Find employees who earn the minimum salary for their job title across all departments.
SELECT e.ENAME, e.JOB, e.SAL
FROM EMP e
WHERE e.SAL = (SELECT MIN(e2.SAL) FROM EMP e2 WHERE e2.JOB = e.JOB);

-- 2.6.6 List all managers (EMPNOs that appear in the MGR column) along with their department names using EXISTS.
SELECT m.ENAME AS Manager_Name, d.DNAME AS Dept_Name
FROM EMP m, DEPT d
WHERE m.DEPTNO = d.DEPTNO
  AND EXISTS (SELECT 1 FROM EMP e WHERE e.MGR = m.EMPNO);

-- 2.6.7 List all non-managerial employees using NOT EXISTS or NOT IN.
SELECT ENAME, JOB, EMPNO
FROM EMP e
WHERE NOT EXISTS (SELECT 1 FROM EMP m WHERE m.MGR = e.EMPNO);


-- 7. Advanced Combined Queries (Joins + Subqueries + Aggregations)

-- 2.7.1 Find the department name and location with the highest total payroll (SUM(SAL)).
SELECT d.DNAME, d.LOC, SUM(e.SAL) AS Total_Payroll
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
GROUP BY d.DEPTNO, d.DNAME, d.LOC
HAVING SUM(e.SAL) = (
  SELECT MAX(dept_sum)
  FROM (SELECT SUM(SAL) AS dept_sum FROM EMP GROUP BY DEPTNO) t
);

-- 2.7.2 Find the department (DNAME) with the highest average salary.
SELECT d.DNAME, AVG(e.SAL) AS Avg_Salary
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
GROUP BY d.DEPTNO, d.DNAME
HAVING AVG(e.SAL) = (
  SELECT MAX(dept_avg)
  FROM (SELECT AVG(SAL) AS dept_avg FROM EMP GROUP BY DEPTNO) t
);

-- 2.7.3 Display the department name, location, employee name, and salary of the top earner in each department.
SELECT d.DNAME, d.LOC, e.ENAME, e.SAL
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
  AND e.SAL = (SELECT MAX(e2.SAL) FROM EMP e2 WHERE e2.DEPTNO = e.DEPTNO);

-- 2.7.4 Find employees who work in 'DALLAS' and earn more than the average salary of the 'CHICAGO' department.
SELECT e.ENAME, e.SAL, d.LOC
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
  AND d.LOC = 'DALLAS'
  AND e.SAL > (
    SELECT AVG(e2.SAL)
    FROM EMP e2, DEPT d2
    WHERE e2.DEPTNO = d2.DEPTNO AND d2.LOC = 'CHICAGO'
  );

-- 2.7.5 Display department names where the average salary is greater than the overall company average salary.
SELECT d.DNAME, AVG(e.SAL) AS Dept_Avg_Salary
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
GROUP BY d.DEPTNO, d.DNAME
HAVING AVG(e.SAL) > (SELECT AVG(SAL) FROM EMP);

-- 2.7.6 Calculate the percentage contribution of each employee's salary toward their department's total payroll.
SELECT e.ENAME, d.DNAME, e.SAL,
  ROUND((e.SAL * 100.0) / (
    SELECT SUM(e2.SAL) FROM EMP e2 WHERE e2.DEPTNO = e.DEPTNO
  ), 2) AS Pct_Dept_Payroll
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO;

-- 2.7.7 Find employees who do not work in 'NEW YORK' but earn more than the highest-paid employee in 'NEW YORK'.
SELECT e.ENAME, e.SAL, d.LOC
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
  AND d.LOC != 'NEW YORK'
  AND e.SAL > (
    SELECT MAX(e2.SAL)
    FROM EMP e2, DEPT d2
    WHERE e2.DEPTNO = d2.DEPTNO AND d2.LOC = 'NEW YORK'
  );

-- 2.7.8 List all department locations and the name of the most recently hired employee in each location.
SELECT d.LOC, e.ENAME, e.HIREDATE
FROM EMP e, DEPT d
WHERE e.DEPTNO = d.DEPTNO
  AND e.HIREDATE = (
    SELECT MAX(e2.HIREDATE)
    FROM EMP e2, DEPT d2
    WHERE e2.DEPTNO = d2.DEPTNO AND d2.LOC = d.LOC
  );
  
 

